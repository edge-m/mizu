{
  "name": "mizu",
  "version": "0.1.0",
  "description": "A lightweight, type-safe API server library for Node.js.",
  "type": "module",
  "workspaces": [
    "packages/mizu-node"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "bench": "vitest bench",
    "bench:fetch": "node --import tsx benchmarks/fetch/bench.mts",
    "bench:fetch:compare": "node benchmarks/fetch/compare.mjs",
    "bench:http": "node --import tsx benchmarks/http-server/benchmark.mts",
    "bench:environment": "node benchmarks/collect-environment.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@types/node": "^26.6.2",
    "hono": "^4.13.9",
    "tsup": "^8.5.0",
    "mitata": "^1.0.34",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
